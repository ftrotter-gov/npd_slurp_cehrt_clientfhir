# ============================================
# Base Directory Definitions (DRY Principle)
# ============================================
# These base directories are defined once and used throughout the file
# NOTE: All paths are relative to slurp/cehrt_slurp/ (where go.py and other scripts are executed)
# 
# NPD_ETL_DIR: Path to the project root (npd_etl/)
#   - From slurp/cehrt_slurp/, go up two levels: ../..
#
# NPD_EHR_SCRAPE_CACHE_BASE_DIR: Path to the external data cache directory (sibling to npd_etl/)
#   - From slurp/cehrt_slurp/, go up three levels and into npd_ehr_scrape_cache: ../../../npd_ehr_scrape_cache
#
NPD_ETL_DIR=../..
NPD_EHR_SCRAPE_CACHE_BASE_DIR=../../../npd_ehr_scrape_cache


# ============================================
# Derived Directory Paths
# ============================================
# Cache and summary directories
CEHRT_CACHE_DIR=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/fhir_json_cache/

# Input data files
LANTERN_CSV_INPUT=${NPD_ETL_DIR}/local_data/lantern_csv/fhir_endpoints.csv
LIST_SOURCES_SUMMARY=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/list_sources_summary.csv

# Service JSON directory
SERVICE_JSON_DIR=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/fhir_json_cache/

# Download delay (seconds)
DOWNLOAD_DELAY=1.0

# Output data directories and files
OUTPUT_DATA_DIR=data/output_data
NORMALIZED_CSV_DIR=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/summary_data/
V2_PARSER_CSV_DIR=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/v2_parser_summary_data/
ORG_TO_NPI_RAW=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/summary_data/step40_org_to_npi.csv
CLEAN_NPI_TO_ORG_FHIR_URL=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/summary_data/step50_clean_npi_to_org_fhir_url.csv
ENRICHED_ENDPOINTS=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/summary_data/step60_enriched_endpoints.csv

# Final reports
CEHRT_FHIR_REPORT_CSV=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/summary_data/step89_CEHRT_FHIR_Report.csv
CEHRT_FHIR_REPORT_MD=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/cache/summary_data/step90_CEHRT_FHIR_Report.md

# Test files
TEST_PIPELINE=test_pipeline.py

# Log Dir
ERROR_LOG_DIR=${NPD_EHR_SCRAPE_CACHE_BASE_DIR}/log/

# API Configuration
NPI_REGISTRY_BASE_URL="https://npiregistry.cms.hhs.gov/api/"
